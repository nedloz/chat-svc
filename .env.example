APP_NAME=chat-svc
LOG_LEVEL=INFO


REDIS_URL=redis://redis:6379/0

USER_ID_HEADER_NAME=x-user-id

HTTP_TIMEOUT_SEC=180
REDIS_PROFILE_TTL_SEC=3600
REDIS_SESSION_TTL_SEC=3600
REDIS_CONNECTION_TTL_SEC=600
REDIS_RECENT_MESSAGES_LIMIT=20
REDIS_RECENT_MESSAGES_TTL_SEC=86400

HISTORY_PAGE_SIZE_MAX=50
STREAM_DB_FLUSH_EVERY_CHARS=120
STREAM_DB_FLUSH_EVERY_MS=400


SERVICE_NAME=chat-svc
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name

SERVICE_NAME=chat-svc

SERVICE_TOKEN=super-secret-token-for-chat-svc

AUTH_PROFILE_URL=http://auth-svc:8000/internal/users/{user_id}/profile
RAG_URL=http://rag-svc:8000/retrieve
RAG_PERIODIC_URL=http://rag-svc:8000/retrieve
LLM_STREAM_URL=http://llm-svc:8000/api/llm/stream
RAG_PERIODIC_INTERVAL_DAYS=20
RAG_PERIODIC_MESSAGES_LIMIT=10
TRUSTED_SERVICE_TOKENS={"llm-svc":"super-secret-token-for-llm-svc","auth-svc":"super-secret-token-for-auth-svc"}
